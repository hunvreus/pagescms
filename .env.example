BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
SESSION_CACHE_SECONDS="60"
DATABASE_URL="file:.data/pagescms.db"
# Optional. Defaults to DATABASE_URL; set only to isolate rebuildable cache data.
CACHE_DATABASE_URL=""
DATABASE_AUTH_TOKEN=""
CACHE_DATABASE_AUTH_TOKEN=""
ADMIN_EMAILS=""

# Optional email-code sign-in through the bundled Resend plugin
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional GitHub sign-in
GITHUB_APP_NAME=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# Optional Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional, but required for email-only collaborator access. Generate
# CRYPTO_KEY with: openssl rand -base64 32
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
CRYPTO_KEY=""

# Require a configured access-policy extension (optional).
PAGESCMS_REQUIRE_ACCESS_POLICY="false"

# Optional local/testing override for the native unsaved-change navigation dialog.
VITE_DISABLE_UNSAVED_WARNING="false"

# Optional local override for the TanStack debug plugin and in-page panel.
VITE_DISABLE_TANSTACK_DEVTOOLS="false"

# Repository cache policy (times in minutes unless named *_MS).
CONFIG_CHECK_MIN="5"
CACHE_CHECK_MIN="5"
FILE_TTL_MIN="1440" # -1 disables periodic full snapshot expiry, not revision checks
BRANCH_HEAD_TTL_MS="15000"
REPO_META_TTL_MS="15000"
WEBHOOK_PUSH_INCREMENTAL_MAX_FILES="120" # 0 disables this threshold
WEBHOOK_PUSH_SCOPED_INVALIDATION_MAX_FILES="800" # 0 disables this threshold
