BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
DATABASE_URL="postgres://user:password@localhost:5432/pagescms"
ADMIN_EMAILS=""

# Optional email-code sign-in through the bundled Resend plugin
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional GitHub sign-in
GITHUB_APP_NAME=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# Optional, but required for email-only collaborator access. Generate
# CRYPTO_KEY with: openssl rand -base64 32
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
CRYPTO_KEY=""

# Hosted deployments must provide an access-policy plugin.
DEPLOYMENT_MODE="self-hosted"

# Optional local/testing override for the native unsaved-change navigation dialog.
VITE_DISABLE_UNSAVED_WARNING="false"

# Optional local override for the TanStack debug plugin and in-page panel.
VITE_DISABLE_TANSTACK_DEVTOOLS="false"
