{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["pagescms.config.ts", "vite-types.ts", "plugins/**/*"]
}
