{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "plugins/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "*.ts",
    "*.js",
    "worker-configuration.d.ts"
  ],
  "exclude": ["_legacy", "node_modules", ".output", ".wrangler"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "#pagescms/deployment/client": ["./src/deployment/default/client.ts"],
      "#pagescms/deployment/server": [
        "./src/deployment/default/server.server.ts"
      ],
      "virtual:pagescms-request-services-bootstrap": [
        "./src/server/request-services-bootstrap.server.ts"
      ]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
