  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "setup:github-app": "node scripts/setup-github-app.mjs",
    "dev": "pnpm reference:build && node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js dev --port 3000",
    "cf:dev": "pnpm reference:build && PAGESCMS_CLOUDFLARE=true vite dev --port 3000",
    "cf:build": "pnpm reference:build && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false PAGESCMS_CLOUDFLARE=true vite build && pnpm performance:check",
    "cf:preview": "PAGESCMS_CLOUDFLARE=true vite preview",
    "generate-routes": "tsr generate",
    "build": "pnpm reference:build && vite build --outDir dist/client && vite build --ssr src/server/index.ts --outDir dist/server && pnpm performance:check",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "pnpm generate-routes && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix",
    "format:check": "prettier --check .",
    "test": "pnpm reference:build && node --test packages/create-pagescms/create.check.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "sh scripts/test-e2e.sh",
    "test:e2e:media-performance": "PAGESCMS_E2E_PRODUCTION=true sh scripts/test-e2e.sh tests/e2e/media-performance.spec.ts",
    "test:integration": "sh scripts/test-integration.sh",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-sqlite.mjs",
    "db:migrate:2x": "node --env-file-if-exists=.env.local scripts/collaborators.mjs migrate-2x",
    "db:collaborators:export": "node --env-file-if-exists=.env.local scripts/collaborators.mjs export",
    "db:collaborators:import": "node --env-file-if-exists=.env.local scripts/collaborators.mjs import",
    "db:collaborators:sql": "node --env-file-if-exists=.env.local scripts/collaborators.mjs sql",
    "cf:typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --config wrangler.jsonc --include-runtime false",
    "cf:typecheck": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --config wrangler.jsonc --include-runtime false --check",
    "cf:dry-run": "pnpm cf:build && node scripts/clean-wrangler-dry-run.mjs && wrangler deploy --dry-run --outdir .wrangler/dry-run --metafile && node scripts/assert-public-artifact.mjs .wrangler/dry-run",
    "validate": "pnpm i18n:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm cf:typecheck && pnpm cf:dry-run",
    "deploy": "pnpm cf:build && wrangler deploy",
    "prepack": "pnpm generate-routes && node scripts/build-package.mjs",
    "test:package": "node scripts/test-package.mjs",
    "reference:build": "node scripts/build-reference.mjs",
    "reference:check": "node scripts/build-reference.mjs --check && pnpm reference:test",
    "reference:test": "node --test scripts/reference-check.mjs",
    "i18n:extract": "lingui extract --overwrite --config src/i18n/lingui.config.mjs",
    "i18n:check": "lingui check sync --overwrite --config src/i18n/lingui.config.mjs && lingui compile --strict --config src/i18n/lingui.config.mjs"
  },
