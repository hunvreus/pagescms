{
  "name": "pagescms",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js dev --port 3000",
    "cf:dev": "PAGESCMS_CLOUDFLARE=true vite dev --port 3000",
    "cf:build": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false PAGESCMS_CLOUDFLARE=true vite build",
    "cf:preview": "PAGESCMS_CLOUDFLARE=true vite preview",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "pnpm generate-routes && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "sh scripts/test-e2e.sh",
    "test:integration": "sh scripts/test-integration.sh",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "cf:typegen": "wrangler types --include-runtime false",
    "cf:typecheck": "wrangler types --include-runtime false --check",
    "cf:dry-run": "pnpm cf:build && wrangler deploy --dry-run --outdir .wrangler/dry-run --metafile",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm cf:typecheck && pnpm cf:dry-run",
    "deploy": "pnpm cf:build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "lucide-react": "^1.32.0",
    "marked": "^18.0.10",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.18.0",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "5.20260819.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
