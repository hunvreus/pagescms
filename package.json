{
  "name": "pagescms",
  "version": "2.1.8",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    "./deployment/contracts/client": "./src/deployment/contracts/client.ts",
    "./deployment/contracts/hosted.server": "./src/deployment/contracts/hosted.server.ts",
    "./deployment/contracts/server.server": "./src/deployment/contracts/server.server.ts",
    "./deployment/contracts/version": "./src/deployment/contracts/version.ts",
    "./deployment/conformance/media-storage": "./src/deployment/conformance/media-storage.ts",
    "./lib/application-operations": "./src/lib/application-operations.ts",
    "./server/access-policy.server": "./src/server/access-policy.server.ts",
    "./server/media-provider.server": "./src/server/media-provider.server.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/operation-error": "./src/components/operation-error.tsx",
    "./lib/collaborator-key": "./src/lib/collaborator-key.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js dev --port 3000",
    "cf:dev": "PAGESCMS_CLOUDFLARE=true vite dev --port 3000",
    "cf:build": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false PAGESCMS_CLOUDFLARE=true vite build && pnpm performance:check",
    "cf:preview": "PAGESCMS_CLOUDFLARE=true vite preview",
    "generate-routes": "tsr generate",
    "build": "vite build && pnpm performance:check",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "preview": "vite preview",
    "typecheck": "pnpm generate-routes && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:composition": "node scripts/test-deployment-composition.mjs",
    "test:watch": "vitest",
    "test:e2e": "sh scripts/test-e2e.sh",
    "test:e2e:media-performance": "PAGESCMS_E2E_PRODUCTION=true sh scripts/test-e2e.sh tests/e2e/media-performance.spec.ts",
    "test:integration": "sh scripts/test-integration.sh",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-sqlite.mjs",
    "db:collaborators:export": "node --env-file-if-exists=.env.local scripts/collaborators.mjs export",
    "db:collaborators:import": "node --env-file-if-exists=.env.local scripts/collaborators.mjs import",
    "cf:typegen": "wrangler types --include-runtime false",
    "cf:typecheck": "wrangler types --include-runtime false --check",
    "cf:dry-run": "pnpm cf:build && node scripts/clean-wrangler-dry-run.mjs && wrangler deploy --dry-run --outdir .wrangler/dry-run --metafile && node scripts/assert-public-artifact.mjs .wrangler/dry-run",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm cf:typecheck && pnpm cf:dry-run",
    "deploy": "pnpm cf:build && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^9.1.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.33.0",
    "marked": "17.0.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tippy.js": "^6.3.7",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "5.20260820.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.32",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "prosemirror-model": "1.25.12",
      "esbuild@<=0.24.2": ">=0.25.0"
    },
    "patchedDependencies": {
      "@tanstack/start-plugin-core@1.171.38": "patches/@tanstack__start-plugin-core@1.171.38.patch",
      "@tanstack/start-server-core@1.169.30": "patches/@tanstack__start-server-core@1.169.30.patch"
    }
  }
}
