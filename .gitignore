# Root ignores for the TanStack Start rewrite.
node_modules/
.output/
.wrangler/
.dev.vars*
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.DS_Store

# Environment files remain local. Commit explicit examples only.
.env*
!.env.example
!.env.local.example

# The legacy tree is source-controlled, but its local dependencies, caches,
# generated builds, secrets, and previous Vinext experiment outputs are not.
_legacy/node_modules/
_legacy/.next/
_legacy/.tmp/
_legacy/.vinext/
_legacy/dist/
_legacy/coverage/
_legacy/*.tsbuildinfo
_legacy/.env*
!_legacy/.env.local.example
